[Unit]
Description=Round Media Player - Mobile Web Remote
After=network.target roundplayer_daemon.service

[Service]
Type=simple
User=bouncer
WorkingDirectory=/home/bouncer/roundplayer
ExecStart=/usr/bin/python3 /home/bouncer/roundplayer/web_remote.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
