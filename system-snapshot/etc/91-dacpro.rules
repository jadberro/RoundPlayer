# Round Media Player: whenever the DAC Pro card (re)appears, re-apply the saved DAC settings after udev's own
# alsactl restore (90-alsa-restore.rules) has run. Detached via systemd-run so udev never waits on it.
ACTION=="add", SUBSYSTEM=="sound", KERNEL=="controlC*", ATTRS{id}=="Pro", RUN+="/usr/bin/systemd-run --no-block --on-active=2 --unit=dacpro-reapply-$env{ALSA_CARD_NUMBER} /usr/local/bin/dacpro-ctl apply"
